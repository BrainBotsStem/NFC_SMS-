PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/attendance
JWT_SECRET=super-secret-long-random-string-change-this-in-production

TZ_NAME=Asia/Colombo
INTAKE_YEAR=26

# A tap becomes the out-time only once this many minutes have passed since the
# in-time; anything sooner is treated as an accidental double-tap and ignored.
OUT_MIN_MINUTES=1
ENROLL_WINDOW_SECONDS=60

# HiveMQ Cloud. Leave blank if not using MQTT.
MQTT_URL=mqtts://ee8608044aae434e91c90dd9612c6ac1.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=BrainBots
MQTT_PASSWORD=BrainBots@2026
MQTT_TOPIC_ROOT=bb/att

# Used only the first time the seed script runs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# The staff attendance side signs in separately.
STAFF_ADMIN_USERNAME=staff
STAFF_ADMIN_PASSWORD=c82yqiL0-wFk

# Runs both the student and the staff side.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=8xUq04UvAAas

# Texts to parents. console = test mode (written to the server log, nothing sent).
# Switch to notifylk and fill in the NOTIFYLK_ values to send real SMS.
NOTIFY_PROVIDER=console
NOTIFY_MODE=daily
NOTIFY_OUT_DELAY_MINUTES=20
NOTIFY_MAX_LATE_MINUTES=60
NOTIFY_CENTRE_NAME=BrainBots
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO
