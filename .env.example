# Copy to .env and fill in.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/attendance
JWT_SECRET=replace-with-a-long-random-string

TZ_NAME=Asia/Colombo
INTAKE_YEAR=26

# A second tap becomes the out time once this many minutes have passed since the in time.
# Sooner than that it is ignored as a double tap.
OUT_MIN_MINUTES=10
# After an out tap, a tap sooner than this is a double tap; later ones start the next class.
REJOIN_MIN_SECONDS=60
# Taps within this many hours of the in time belong to the same visit. Later, a tap is a new in.
VISIT_WINDOW_HOURS=12
ENROLL_WINDOW_SECONDS=60

# HiveMQ Cloud. The URL comes from your cluster page.
MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=bb/att

# Used only the first time the seed script runs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Runs both the student and the staff side.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change-me-as-well

# The staff attendance side signs in separately.
STAFF_ADMIN_USERNAME=staff
STAFF_ADMIN_PASSWORD=change-me-too

