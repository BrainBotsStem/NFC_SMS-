# Copy to .env and fill in.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/attendance
JWT_SECRET=replace-with-a-long-random-string

TZ_NAME=Asia/Colombo
INTAKE_YEAR=26

# A second tap becomes the out time once this many minutes have passed since the in time.
# Sooner than that it is ignored as a double tap.
OUT_MIN_MINUTES=10
# After an out tap, a tap sooner than this is a double tap; later ones start the next class.
REJOIN_MIN_SECONDS=60
# Taps within this many hours of the in time belong to the same visit. Later, a tap is a new in.
VISIT_WINDOW_HOURS=12
ENROLL_WINDOW_SECONDS=60

# HiveMQ Cloud. The URL comes from your cluster page.
MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=bb/att

# Used only the first time the seed script runs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Runs both the student and the staff side.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change-me-as-well

# The staff attendance side signs in separately.
STAFF_ADMIN_USERNAME=staff
STAFF_ADMIN_PASSWORD=change-me-too

# Texts to parents when a student arrives and leaves.
# off: nothing is sent · console: written to the server log, not sent (for trying it out)
# notifylk: real SMS through Notify.lk (https://notify.lk)
NOTIFY_PROVIDER=off
# daily: one "arrived" and one "left" per stay · every: a text for every in and out tap
NOTIFY_MODE=daily
# daily mode: a "left" text waits this long, and is dropped if the student taps in again first.
NOTIFY_OUT_DELAY_MINUTES=20
# A tap that reaches the server later than this (the reader was offline) is not texted.
NOTIFY_MAX_LATE_MINUTES=60
NOTIFY_COUNTRY_CODE=94
NOTIFY_CENTRE_NAME=BrainBots
# Optional wording. Placeholders: {centre} {name} {id} {batch} {time} {date}
# NOTIFY_TEMPLATE_IN={centre}: {name} ({id}) arrived at {time} on {date}. {batch}.
# NOTIFY_TEMPLATE_OUT={centre}: {name} ({id}) left at {time} on {date}.
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO
